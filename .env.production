# CARIBE SCIENCE — Production Environment Variables
# Copy this to .env.production and fill in values

# --- Database (PostgreSQL for production) ---
DATABASE_URL=postgresql+psycopg2://caribe:YOUR_PASSWORD@localhost:5432/caribe_science

# --- Security (GENERATE STRONG KEYS!) ---
SECRET_KEY=your-super-secret-key-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://caribescience.com,https://www.caribescience.com

# --- Storage (S3-compatible for production) ---
STORAGE_BACKEND=s3
STORAGE_ENDPOINT=your-s3-endpoint
STORAGE_BUCKET=caribe-science-uploads
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# --- Scientific metadata providers (free tier) ---
CROSSREF_EMAIL=contact@caribescience.com
OPENALEX_EMAIL=contact@caribescience.com
UNPAYWALL_EMAIL=contact@caribescience.com

# --- ORCID ---
ORCID_CLIENT_ID=your-orcid-client-id
ORCID_CLIENT_SECRET=your-orcid-client-secret

# --- AI: Ollama (local) or OpenAI-compatible ---
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen3:8b
AI_API_KEY=

# --- Email (production SMTP) ---
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@caribescience.com
SMTP_PASSWORD=your-email-password
EMAIL_VERIFICATION=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://api.caribescience.com

# --- Railway ---
RAILWAY_TOKEN=your-railway-token

# --- Domain ---
DOMAIN=caribescience.com
