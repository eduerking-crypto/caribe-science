# --- Database (default: SQLite para desarrollo local sin Docker) ---
# PostgreSQL (docker compose o server propio):
# DATABASE_URL=postgresql+psycopg2://caribe:caribe@localhost:5432/caribe_science
DATABASE_URL=sqlite:///./caribe_science.db

# --- Security ---
SECRET_KEY=change-me-in-production-insecure-dev-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Storage (local por defecto; S3-compatible en producción) ---
STORAGE_BACKEND=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Scientific metadata providers (gratuitos) ---
CROSSREF_EMAIL=contact@caribescience.example
OPENALEX_EMAIL=contact@caribescience.example
UNPAYWALL_EMAIL=contact@caribescience.example

# --- ORCID ---
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# --- AI: local (ollama) por defecto; degrada elegantemente si no responde ---
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen3:8b
AI_API_KEY=

# --- Email (dev: Mailpit; prod: SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_VERIFICATION=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000